(define (problem lifelong_crossroom__pomaria__freezer_meat_elapsed_tasks_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        door.n.01_1 door.n.01_2 - door.n.01
        chicken.n.01_1 chicken.n.01_2 - chicken.n.01
        compost_bin.n.01_1 compost_bin.n.01_2 - compost_bin.n.01
        hamper.n.02_1 - hamper.n.02
        stain.n.01_1 - stain.n.01
        water.n.06_1 - water.n.06
        electric_refrigerator.n.01_1 - electric_refrigerator.n.01
        sink.n.01_1 - sink.n.01
        countertop.n.01_1 - countertop.n.01
        table.n.02_1 - table.n.02
        shelf.n.01_1 - shelf.n.01
        washer.n.03_1 - washer.n.03
        clothes_dryer.n.01_1 - clothes_dryer.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 kitchen_0)
        (inroom floor.n.01_2 corridor_0)
        (inroom floor.n.01_3 living_room_0)
        (inroom door.n.01_1 kitchen_0)
        (inroom door.n.01_2 corridor_0)
        (ontop compost_bin.n.01_1 floor.n.01_2)
        (ontop hamper.n.02_1 floor.n.01_3)
        (ontop chicken.n.01_2 countertop.n.01_1)
        (inroom electric_refrigerator.n.01_1 kitchen_0)
        (ontop compost_bin.n.01_2 floor.n.01_3)
        (inroom sink.n.01_1 kitchen_0)
        (insource sink.n.01_1 water.n.06_1)
        (inside chicken.n.01_1 electric_refrigerator.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (not (frozen chicken.n.01_1))
            (inside chicken.n.01_1 electric_refrigerator.n.01_1)
            (ontop compost_bin.n.01_1 floor.n.01_2)
            (not (covered hamper.n.02_1 stain.n.01_1))
        )
    )
)
