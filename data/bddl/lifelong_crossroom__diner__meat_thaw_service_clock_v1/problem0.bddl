(define (problem lifelong_crossroom__diner__meat_thaw_service_clock_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        door.n.01_1 door.n.01_2 door.n.01_3 - door.n.01
        chicken.n.01_1 chicken.n.01_2 - chicken.n.01
        table.n.02_1 - table.n.02
        stain.n.01_1 - stain.n.01
        sink.n.01_1 sink.n.01_2 - sink.n.01
        water.n.06_1 - water.n.06
        electric_refrigerator.n.01_1 - electric_refrigerator.n.01
        compost_bin.n.01_1 - compost_bin.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 kitchen_0)
        (inroom floor.n.01_2 dining_room_0)
        (inroom floor.n.01_3 bathroom_0)
        (inroom door.n.01_1 kitchen_0)
        (inroom door.n.01_2 dining_room_0)
        (inroom door.n.01_3 bathroom_0)
        (ontop chicken.n.01_1 floor.n.01_1)
        (frozen chicken.n.01_1)
        (inroom table.n.02_1 dining_room_0)
        (covered table.n.02_1 stain.n.01_1)
        (inroom sink.n.01_1 bathroom_0)
        (covered sink.n.01_1 stain.n.01_1)
        (ontop chicken.n.01_2 floor.n.01_1)
        (inroom electric_refrigerator.n.01_1 kitchen_0)
        (ontop compost_bin.n.01_1 floor.n.01_3)
        (inroom sink.n.01_2 kitchen_0)
        (insource sink.n.01_2 water.n.06_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (not (frozen chicken.n.01_1))
            (not (covered table.n.02_1 stain.n.01_1))
            (not (covered sink.n.01_1 stain.n.01_1))
            (inside chicken.n.01_2 electric_refrigerator.n.01_1)
            (not (open electric_refrigerator.n.01_1))
            (not (open door.n.01_1))
            (not (open door.n.01_2))
            (not (open door.n.01_3))
        )
    )
)
