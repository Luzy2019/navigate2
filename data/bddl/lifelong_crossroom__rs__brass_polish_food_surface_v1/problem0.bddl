(define (problem lifelong_crossroom__rs__brass_polish_food_surface_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        door.n.01_1 - door.n.01
        brass.n.02_1 - brass.n.02
        polish.n.03_1 - polish.n.03
        countertop.n.01_1 - countertop.n.01
        dirt.n.02_1 - dirt.n.02
        rag.n.01_1 rag.n.01_2 - rag.n.01
        compost_bin.n.01_1 - compost_bin.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 living_room_0)
        (inroom floor.n.01_2 bedroom_0)
        (inroom floor.n.01_3 kitchen_0)
        (inroom door.n.01_1 bedroom_0)
        (ontop brass.n.02_1 floor.n.01_1)
        (inroom countertop.n.01_1 kitchen_0)
        (covered countertop.n.01_1 dirt.n.02_1)
        (ontop rag.n.01_1 floor.n.01_1)
        (ontop compost_bin.n.01_1 floor.n.01_3)
        (ontop rag.n.01_2 floor.n.01_1)
        (saturated rag.n.01_1 polish.n.03_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (covered brass.n.02_1 polish.n.03_1)
            (ontop rag.n.01_1 floor.n.01_3)
            (ontop rag.n.01_2 floor.n.01_3)
            (not (covered countertop.n.01_1 dirt.n.02_1))
            (or (nextto rag.n.01_1 countertop.n.01_1) (nextto rag.n.01_2 countertop.n.01_1))
            (not (covered countertop.n.01_1 polish.n.03_1))
            (inside rag.n.01_1 compost_bin.n.01_1)
            (not (nextto rag.n.01_1 countertop.n.01_1))
            (nextto rag.n.01_2 countertop.n.01_1)
            (not (open door.n.01_1))
        )
    )
)
