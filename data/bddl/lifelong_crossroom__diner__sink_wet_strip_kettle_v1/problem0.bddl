(define (problem lifelong_crossroom__diner__sink_wet_strip_kettle_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        door.n.01_1 door.n.01_2 - door.n.01
        sink.n.01_1 - sink.n.01
        stain.n.01_1 - stain.n.01
        bottom_cabinet.n.01_1 - bottom_cabinet.n.01
        plate.n.04_1 - plate.n.04
        table.n.02_1 - table.n.02
        power_strip.n.01_1 power_strip.n.01_2 - power_strip.n.01
        water.n.06_1 - water.n.06
        electric_kettle.n.01_1 - electric_kettle.n.01
        compost_bin.n.01_1 - compost_bin.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 kitchen_0)
        (inroom floor.n.01_2 bar_0)
        (inroom floor.n.01_3 dining_room_0)
        (inroom door.n.01_1 kitchen_0)
        (inroom door.n.01_2 dining_room_0)
        (inroom sink.n.01_1 kitchen_0)
        (covered sink.n.01_1 stain.n.01_1)
        (inroom bottom_cabinet.n.01_1 bar_0)
        (covered bottom_cabinet.n.01_1 stain.n.01_1)
        (ontop plate.n.04_1 floor.n.01_3)
        (inroom table.n.02_1 dining_room_0)
        (ontop power_strip.n.01_1 floor.n.01_1)
        (ontop electric_kettle.n.01_1 floor.n.01_3)
        (ontop compost_bin.n.01_1 floor.n.01_3)
        (ontop power_strip.n.01_2 floor.n.01_1)
        (covered power_strip.n.01_1 water.n.06_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (not (covered sink.n.01_1 stain.n.01_1))
            (not (covered bottom_cabinet.n.01_1 stain.n.01_1))
            (ontop power_strip.n.01_1 floor.n.01_3)
            (ontop power_strip.n.01_2 floor.n.01_3)
            (ontop plate.n.04_1 table.n.02_1)
            (or (nextto power_strip.n.01_1 electric_kettle.n.01_1) (nextto power_strip.n.01_2 electric_kettle.n.01_1))
            (not (nextto power_strip.n.01_1 electric_kettle.n.01_1))
            (inside power_strip.n.01_1 compost_bin.n.01_1)
            (nextto power_strip.n.01_2 electric_kettle.n.01_1)
            (not (open door.n.01_1))
            (not (open door.n.01_2))
        )
    )
)
