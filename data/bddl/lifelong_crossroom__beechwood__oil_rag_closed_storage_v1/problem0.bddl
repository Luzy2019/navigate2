(define (problem lifelong_crossroom__beechwood__oil_rag_closed_storage_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        bicycle_chain.n.01_1 - bicycle_chain.n.01
        lubricant.n.01_1 - lubricant.n.01
        lubricant__bottle.n.01_1 - lubricant__bottle.n.01
        sponge.n.01_1 - sponge.n.01
        dust.n.01_1 - dust.n.01
        bottom_cabinet.n.01_1 - bottom_cabinet.n.01
        rag.n.01_2 rag.n.01_3 - rag.n.01
        carton.n.02_1 carton.n.02_2 - carton.n.02
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 utility_room_0)
        (inroom floor.n.01_2 corridor_0)
        (inroom floor.n.01_3 storage_room_1)
        (inroom bottom_cabinet.n.01_1 utility_room_0)
        (filled lubricant__bottle.n.01_1 lubricant.n.01_1)
        (ontop lubricant__bottle.n.01_1 floor.n.01_1)
        (ontop bicycle_chain.n.01_1 floor.n.01_1)
        (ontop sponge.n.01_1 floor.n.01_1)
        (covered bicycle_chain.n.01_1 dust.n.01_1)
        (ontop rag.n.01_2 bottom_cabinet.n.01_1)
        (ontop rag.n.01_3 bottom_cabinet.n.01_1)
        (ontop carton.n.02_1 floor.n.01_1)
        (ontop carton.n.02_2 floor.n.01_3)
        (not (open carton.n.02_1))
        (not (open carton.n.02_2))
    )

    (:goal
        (and
            (not (covered bicycle_chain.n.01_1 dust.n.01_1))
            (covered bicycle_chain.n.01_1 lubricant.n.01_1)
            (saturated rag.n.01_2 lubricant.n.01_1)
            (ontop carton.n.02_1 floor.n.01_3)
            (or
                (and
                    (inside rag.n.01_2 carton.n.02_1)
                    (inside rag.n.01_3 carton.n.02_2)
                )
                (and
                    (inside rag.n.01_3 carton.n.02_1)
                    (inside rag.n.01_2 carton.n.02_2)
                )
            )
            (open carton.n.02_1)
            (not (open carton.n.02_2))
        )
    )
)
