(define (problem lifelong_crossroom__rs__shared_towel_denture_food_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        door.n.01_1 - door.n.01
        mug.n.04_1 - mug.n.04
        bottom_cabinet.n.01_1 - bottom_cabinet.n.01
        table.n.02_1 - table.n.02
        dust.n.01_1 - dust.n.01
        apple.n.01_1 - apple.n.01
        plate.n.04_1 plate.n.04_2 - plate.n.04
        rag.n.01_1 rag.n.01_2 - rag.n.01
        stain.n.01_1 - stain.n.01
        compost_bin.n.01_1 - compost_bin.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 bedroom_0)
        (inroom floor.n.01_2 living_room_0)
        (inroom floor.n.01_3 kitchen_0)
        (inroom door.n.01_1 bedroom_0)
        (ontop mug.n.04_1 floor.n.01_1)
        (inroom bottom_cabinet.n.01_1 bedroom_0)
        (inroom table.n.02_1 living_room_0)
        (covered table.n.02_1 dust.n.01_1)
        (ontop apple.n.01_1 floor.n.01_3)
        (ontop plate.n.04_1 floor.n.01_3)
        (ontop rag.n.01_1 floor.n.01_1)
        (ontop plate.n.04_2 floor.n.01_3)
        (ontop compost_bin.n.01_1 floor.n.01_3)
        (ontop rag.n.01_2 floor.n.01_1)
        (saturated rag.n.01_1 stain.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (inside mug.n.04_1 bottom_cabinet.n.01_1)
            (not (covered table.n.02_1 dust.n.01_1))
            (ontop rag.n.01_1 floor.n.01_3)
            (ontop rag.n.01_2 floor.n.01_3)
            (ontop apple.n.01_1 plate.n.04_1)
            (or (nextto rag.n.01_1 plate.n.04_2) (nextto rag.n.01_2 plate.n.04_2))
            (not (covered plate.n.04_2 stain.n.01_1))
            (not (nextto rag.n.01_1 plate.n.04_2))
            (nextto rag.n.01_2 plate.n.04_2)
            (not (open door.n.01_1))
        )
    )
)
