(define (problem lifelong_crossroom__beechwood__jar_seal_status_after_canning_v1-0)
    (:domain omnigibson)

    (:objects
        mug.n.04_1 - mug.n.04
        mason_jar.n.01_1 - mason_jar.n.01
        peach.n.03_1 - peach.n.03
        water.n.06_1 - water.n.06
        cooked__water.n.01_1 - cooked__water.n.01
        microwave.n.02_1 - microwave.n.02
        sink.n.01_1 - sink.n.01
        countertop.n.01_1 - countertop.n.01
        table.n.02_1 table.n.02_2 - table.n.02
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 kitchen_0)
        (ontop agent.n.01_1 floor.n.01_1)
        (inroom microwave.n.02_1 kitchen_0)
        (inroom sink.n.01_1 kitchen_0)
        (insource sink.n.01_1 water.n.06_1)
        (inroom countertop.n.01_1 kitchen_0)
        (inroom table.n.02_1 kitchen_0)
        (ontop mug.n.04_1 table.n.02_1)
        (filled mug.n.04_1 water.n.06_1)
        (future cooked__water.n.01_1)

        (inroom table.n.02_2 living_room_0)
        (ontop mason_jar.n.01_1 table.n.02_2)
        (inside peach.n.03_1 mason_jar.n.01_1)
        (open mason_jar.n.01_1)
    )

    (:goal
        (and
            (inside peach.n.03_1 mason_jar.n.01_1)
            (filled mason_jar.n.01_1 cooked__water.n.01_1)
            (ontop mason_jar.n.01_1 table.n.02_1)
            (open mason_jar.n.01_1)
            (ontop mug.n.04_1 table.n.02_1)
            (not (inside mug.n.04_1 sink.n.01_1))
            (not (toggled_on microwave.n.02_1))
            (not (open microwave.n.02_1))
        )
    )
)
