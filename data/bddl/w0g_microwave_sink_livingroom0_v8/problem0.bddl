(define (problem w0g_microwave_sink_livingroom0_v8-0)
    (:domain omnigibson)

    (:objects
        water.n.06_1 - water.n.06
        cooked__water.n.01_1 - cooked__water.n.01
        water_glass.n.02_1 - water_glass.n.02
        cabinet.n.01_1 - cabinet.n.01
        sink.n.01_1 - sink.n.01
        microwave.n.02_1 - microwave.n.02
        stain.n.01_1 - stain.n.01
        sponge.n.01_1 - sponge.n.01
        liquid_soap.n.01_1 - liquid_soap.n.01
        liquid_soap__bottle.n.01_1 - liquid_soap__bottle.n.01
        countertop.n.01_1 - countertop.n.01
        book.n.01_1 - book.n.01
        cedar_chest.n.01_1 - cedar_chest.n.01
        floor.n.01_1 floor.n.01_2 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inside water_glass.n.02_1 cabinet.n.01_1)
        (insource sink.n.01_1 water.n.06_1)
        (future cooked__water.n.01_1)
        (not (open microwave.n.02_1))
        (not (toggled_on microwave.n.02_1))
        (not (toggled_on sink.n.01_1))
        (covered sink.n.01_1 stain.n.01_1)
        (ontop sponge.n.01_1 countertop.n.01_1)
        (filled liquid_soap__bottle.n.01_1 liquid_soap.n.01_1)
        (ontop liquid_soap__bottle.n.01_1 countertop.n.01_1)
        (ontop book.n.01_1 floor.n.01_2)
        (not (open cedar_chest.n.01_1))
        (ontop cedar_chest.n.01_1 floor.n.01_2)
        (inroom cabinet.n.01_1 kitchen_0)
        (inroom sink.n.01_1 kitchen_0)
        (inroom microwave.n.02_1 kitchen_0)
        (inroom countertop.n.01_1 kitchen_0)
        (inroom floor.n.01_1 kitchen_0)
        (inroom floor.n.01_2 living_room_0)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (real cooked__water.n.01_1)
            (filled water_glass.n.02_1 cooked__water.n.01_1)
            (not (covered sink.n.01_1 stain.n.01_1))
            (inside book.n.01_1 cedar_chest.n.01_1)
            (not (toggled_on microwave.n.02_1))
            (not (open microwave.n.02_1))
            (not (inside water_glass.n.02_1 microwave.n.02_1))
            (not (toggled_on sink.n.01_1))
            (not (open cedar_chest.n.01_1))
        )
    )
)
