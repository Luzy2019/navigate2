(define (problem lifelong_crossroom__beechwood__raw_board_ready_plate_v1-0)
    (:domain omnigibson)

    (:objects
        carton.n.02_1 carton.n.02_2 carton.n.02_3 - carton.n.02
        vase.n.01_1 - vase.n.01
        weight.n.02_1 - weight.n.02
        desk.n.01_1 - desk.n.01
        bottom_cabinet.n.01_1 - bottom_cabinet.n.01
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_3 private_office_0)
        (ontop agent.n.01_1 floor.n.01_3)
        (inroom desk.n.01_1 private_office_0)
        (inroom bottom_cabinet.n.01_1 private_office_0)
        (ontop vase.n.01_1 desk.n.01_1)
        (open carton.n.02_1)

        (inroom floor.n.01_1 corridor_0)
        (ontop weight.n.02_1 floor.n.01_1)
        (open carton.n.02_2)

        (inroom floor.n.01_2 living_room_1)
        (not (open carton.n.02_3))
    )

    (:goal
        (and
            (ontop carton.n.02_3 bottom_cabinet.n.01_1)
            (ontop carton.n.02_1 carton.n.02_2)
            (ontop carton.n.02_2 floor.n.01_3)
            (not (ontop carton.n.02_1 bottom_cabinet.n.01_1))
            (not (ontop carton.n.02_2 bottom_cabinet.n.01_1))
            (not (ontop carton.n.02_2 carton.n.02_1))
            (not (ontop carton.n.02_2 carton.n.02_3))
            (inside vase.n.01_1 carton.n.02_1)
            (inside weight.n.02_1 carton.n.02_2)
            (not (open carton.n.02_1))
            (not (open carton.n.02_2))
            (not (open carton.n.02_3))
        )
    )
)
