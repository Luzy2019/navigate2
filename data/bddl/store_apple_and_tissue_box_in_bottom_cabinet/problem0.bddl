(define (problem store_apple_and_tissue_box_in_bottom_cabinet-0)
    (:domain omnigibson)

    (:objects
        apple.n.01_1 - apple.n.01
        box__of__tissue.n.01_1 - box__of__tissue.n.01
        half__banana.n.01_1 - half__banana.n.01
        ashcan.n.01_1 - ashcan.n.01
        detergent__bottle.n.01_1 - detergent__bottle.n.01
        dishtowel.n.01_1 - dishtowel.n.01
        dish_rack.n.01_1 - dish_rack.n.01
        countertop.n.01_1 - countertop.n.01
        cabinet.n.01_1 cabinet.n.01_2 - cabinet.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inside apple.n.01_1 cabinet.n.01_1)
        (ontop box__of__tissue.n.01_1 countertop.n.01_1)
        (ontop half__banana.n.01_1 countertop.n.01_1)
        (ontop detergent__bottle.n.01_1 countertop.n.01_1)
        (ontop dishtowel.n.01_1 countertop.n.01_1)
        (ontop ashcan.n.01_1 floor.n.01_1)
        (inroom countertop.n.01_1 kitchen)
        (inroom cabinet.n.01_1 kitchen)
        (inroom cabinet.n.01_2 kitchen)
        (inroom floor.n.01_1 kitchen)
        (inroom half__banana.n.01_1 kitchen)
        (inroom ashcan.n.01_1 kitchen)
        (inroom detergent__bottle.n.01_1 kitchen)
        (inroom dishtowel.n.01_1 kitchen)
        (inroom dish_rack.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (inside ?half__banana.n.01_1 ?ashcan.n.01_1)
            (inside ?detergent__bottle.n.01_1 ?cabinet.n.01_2)
            (ontop ?dishtowel.n.01_1 ?dish_rack.n.01_1)
        )
    )
)
