(define (problem lifelong_crossroom__rs__polish_rag_table_lamp_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        door.n.01_1 door.n.01_2 - door.n.01
        brass.n.02_1 - brass.n.02
        polish.n.03_1 - polish.n.03
        mug.n.04_1 - mug.n.04
        bottom_cabinet.n.01_1 - bottom_cabinet.n.01
        rag.n.01_1 rag.n.01_2 rag.n.01_3 - rag.n.01
        bucket.n.01_1 - bucket.n.01
        table_lamp.n.01_1 - table_lamp.n.01
        compost_bin.n.01_1 - compost_bin.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 living_room_0)
        (inroom floor.n.01_2 bedroom_0)
        (inroom floor.n.01_3 entryway_0)
        (inroom door.n.01_1 bedroom_0)
        (inroom door.n.01_2 entryway_0)
        (ontop brass.n.02_1 floor.n.01_1)
        (ontop mug.n.04_1 floor.n.01_2)
        (inroom bottom_cabinet.n.01_1 bedroom_0)
        (ontop rag.n.01_1 floor.n.01_3)
        (ontop bucket.n.01_1 floor.n.01_3)
        (ontop rag.n.01_2 floor.n.01_1)
        (ontop table_lamp.n.01_1 floor.n.01_3)
        (ontop compost_bin.n.01_1 floor.n.01_3)
        (ontop rag.n.01_3 floor.n.01_1)
        (saturated rag.n.01_2 polish.n.03_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (covered brass.n.02_1 polish.n.03_1)
            (inside mug.n.04_1 bottom_cabinet.n.01_1)
            (ontop rag.n.01_2 floor.n.01_3)
            (ontop rag.n.01_3 floor.n.01_3)
            (inside rag.n.01_1 bucket.n.01_1)
            (or (nextto rag.n.01_2 table_lamp.n.01_1) (nextto rag.n.01_3 table_lamp.n.01_1))
            (not (inside rag.n.01_2 compost_bin.n.01_1))
            (not (nextto rag.n.01_2 table_lamp.n.01_1))
            (nextto rag.n.01_3 table_lamp.n.01_1)
            (not (open door.n.01_1))
            (not (open door.n.01_2))
        )
    )
)
