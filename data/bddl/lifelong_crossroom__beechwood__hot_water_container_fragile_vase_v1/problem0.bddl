        water_bottle.n.01_1 water_bottle.n.01_2 - water_bottle.n.01
        water.n.06_1 - water.n.06
        cooked__water.n.01_1 - cooked__water.n.01
        vase.n.01_1 - vase.n.01
        stain.n.01_1 - stain.n.01
        table.n.02_1 table.n.02_2 - table.n.02
        countertop.n.01_1 - countertop.n.01
        microwave.n.02_1 - microwave.n.02
        sink.n.01_1 - sink.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 kitchen_0)
        (inroom floor.n.01_2 living_room_0)
        (inroom floor.n.01_3 corridor_0)
        (inroom table.n.02_1 kitchen_0)
        (ontop water_bottle.n.01_1 table.n.02_1)
        (ontop water_bottle.n.01_2 table.n.02_1)
        (filled water_bottle.n.01_1 water.n.06_1)
