(define (problem lifelong_crossroom__pomaria__knife_box_laundry_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        door.n.01_1 door.n.01_2 - door.n.01
        eggplant.n.01_1 - eggplant.n.01
        hamper.n.02_1 hamper.n.02_2 - hamper.n.02
        stain.n.01_1 - stain.n.01
        vase.n.01_1 - vase.n.01
        compost_bin.n.01_1 compost_bin.n.01_2 - compost_bin.n.01
        tupperware.n.01_1 tupperware.n.01_2 - tupperware.n.01
        carving_knife.n.01_1 - carving_knife.n.01
        countertop.n.01_1 - countertop.n.01
        table.n.02_1 - table.n.02
        shelf.n.01_1 - shelf.n.01
        washer.n.03_1 - washer.n.03
        clothes_dryer.n.01_1 - clothes_dryer.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 kitchen_0)
        (inroom floor.n.01_2 utility_room_0)
        (inroom floor.n.01_3 storage_room_0)
        (inroom door.n.01_1 kitchen_0)
        (inroom door.n.01_2 utility_room_0)
        (ontop eggplant.n.01_1 countertop.n.01_1)
        (ontop hamper.n.02_1 floor.n.01_2)
        (ontop compost_bin.n.01_1 floor.n.01_3)
        (ontop tupperware.n.01_1 table.n.02_1)
        (ontop hamper.n.02_2 floor.n.01_3)
        (ontop compost_bin.n.01_2 floor.n.01_3)
        (ontop tupperware.n.01_2 table.n.02_1)
        (under carving_knife.n.01_1 tupperware.n.01_1)
        (inside vase.n.01_1 compost_bin.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop eggplant.n.01_1 countertop.n.01_1)
            (not (covered hamper.n.02_1 stain.n.01_1))
            (inside vase.n.01_1 compost_bin.n.01_1)
            (ontop tupperware.n.01_2 table.n.02_1)
        )
    )
)
