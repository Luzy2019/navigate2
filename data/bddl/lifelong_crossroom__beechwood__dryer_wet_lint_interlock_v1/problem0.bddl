(define (problem lifelong_crossroom__beechwood__dryer_wet_lint_interlock_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        lint_screen.n.01_1 lint_screen.n.01_2 lint_screen.n.01_3 - lint_screen.n.01
        lint.n.01_1 - lint.n.01
        dust.n.01_1 - dust.n.01
        water.n.06_1 - water.n.06
        sink.n.01_1 - sink.n.01
        washer.n.03_1 - washer.n.03
        clothes_dryer.n.01_1 - clothes_dryer.n.01
        desk.n.01_1 - desk.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 utility_room_0)
        (inroom floor.n.01_2 corridor_0)
        (inroom floor.n.01_3 private_office_0)
        (inroom clothes_dryer.n.01_1 utility_room_0)
        (inside lint_screen.n.01_1 clothes_dryer.n.01_1)
        (covered lint_screen.n.01_1 lint.n.01_1)
        (covered lint_screen.n.01_1 dust.n.01_1)
        (inroom washer.n.03_1 utility_room_0)
        (inroom sink.n.01_1 utility_room_0)
        (insource sink.n.01_1 water.n.06_1)
        (ontop lint_screen.n.01_3 floor.n.01_2)
        (covered lint_screen.n.01_3 lint.n.01_1)
        (covered lint_screen.n.01_3 dust.n.01_1)
        (inroom desk.n.01_1 private_office_0)
        (ontop lint_screen.n.01_2 desk.n.01_1)
        (ontop agent.n.01_1 floor.n.01_3)
    )

    (:goal
        (and
            (not (covered lint_screen.n.01_1 lint.n.01_1))
            (not (covered lint_screen.n.01_1 dust.n.01_1))
            (not (covered lint_screen.n.01_3 lint.n.01_1))
            (not (covered lint_screen.n.01_3 dust.n.01_1))
            (covered lint_screen.n.01_3 water.n.06_1)
            (not (inside lint_screen.n.01_3 clothes_dryer.n.01_1))
            (inside lint_screen.n.01_2 clothes_dryer.n.01_1)
            (not (covered lint_screen.n.01_2 water.n.06_1))
            (toggled_on clothes_dryer.n.01_1)
            (ontop lint_screen.n.01_1 desk.n.01_1)
        )
    )
)
