(define (problem w0g_preserve_popper_storage1_v8-0)
    (:domain omnigibson)

    (:objects
        tupperware.n.01_1 - tupperware.n.01
        chicken_soup.n.01_1 - chicken_soup.n.01
        mason_jar.n.01_1 - mason_jar.n.01
        electric_refrigerator.n.01_1 - electric_refrigerator.n.01
        countertop.n.01_1 - countertop.n.01
        popper.n.03_1 - popper.n.03
        stain.n.01_1 - stain.n.01
        scrub_brush.n.01_1 scrub_brush.n.01_2 - scrub_brush.n.01
        sink.n.01_1 - sink.n.01
        water.n.06_1 - water.n.06
        door.n.01_1 - door.n.01
        dust.n.01_1 - dust.n.01
        bucket.n.01_1 - bucket.n.01
        book.n.01_1 - book.n.01
        floor.n.01_1 floor.n.01_2 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (filled tupperware.n.01_1 chicken_soup.n.01_1)
        (inside tupperware.n.01_1 electric_refrigerator.n.01_1)
        (ontop mason_jar.n.01_1 countertop.n.01_1)
        (open mason_jar.n.01_1)
        (not (open electric_refrigerator.n.01_1))
        (covered popper.n.03_1 stain.n.01_1)
        (toggled_on popper.n.03_1)
        (ontop popper.n.03_1 floor.n.01_1)
        (ontop scrub_brush.n.01_1 countertop.n.01_1)
        (insource sink.n.01_1 water.n.06_1)
        (covered door.n.01_1 dust.n.01_1)
        (not (open door.n.01_1))
        (ontop scrub_brush.n.01_2 floor.n.01_2)
        (ontop bucket.n.01_1 floor.n.01_2)
        (ontop book.n.01_1 floor.n.01_2)
        (inroom electric_refrigerator.n.01_1 kitchen_0)
        (inroom countertop.n.01_1 kitchen_0)
        (inroom sink.n.01_1 kitchen_0)
        (inroom floor.n.01_1 kitchen_0)
        (inroom door.n.01_1 storage_room_0)
        (inroom floor.n.01_2 storage_room_0)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (contains mason_jar.n.01_1 chicken_soup.n.01_1)
            (not (covered popper.n.03_1 stain.n.01_1))
            (not (covered door.n.01_1 dust.n.01_1))
            (inside book.n.01_1 bucket.n.01_1)
            (not (open door.n.01_1))
            (not (open mason_jar.n.01_1))
            (not (open electric_refrigerator.n.01_1))
            (not (toggled_on popper.n.03_1))
        )
    )
)
