(define (problem lifelong_crossroom__beechwood__quiche_wrap_identity_v1-0)
    (:domain omnigibson)

    (:objects
        plate.n.04_1 plate.n.04_2 - plate.n.04
        quiche.n.02_1 quiche.n.02_2 - quiche.n.02
        mason_jar.n.01_1 mason_jar.n.01_2 - mason_jar.n.01
        electric_refrigerator.n.01_1 - electric_refrigerator.n.01
        dust.n.01_1 - dust.n.01
        broom.n.01_1 - broom.n.01
        tray.n.01_1 - tray.n.01
        coffee_table.n.01_1 - coffee_table.n.01
        countertop.n.01_1 - countertop.n.01
        table.n.02_2 table.n.02_3 - table.n.02
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 storage_room_0)
        (ontop agent.n.01_1 floor.n.01_1)
        (ontop coffee_table.n.01_1 floor.n.01_1)
        (covered coffee_table.n.01_1 dust.n.01_1)
        (ontop plate.n.04_1 coffee_table.n.01_1)
        (not (covered plate.n.04_1 dust.n.01_1))
        (ontop broom.n.01_1 coffee_table.n.01_1)

        (inroom table.n.02_2 kitchen_0)
        (ontop mason_jar.n.01_1 table.n.02_2)
        (ontop mason_jar.n.01_2 table.n.02_2)
        (inroom countertop.n.01_1 kitchen_0)
        (ontop quiche.n.02_1 countertop.n.01_1)
        (ontop quiche.n.02_2 countertop.n.01_1)
        (ontop tray.n.01_1 countertop.n.01_1)
        (not (open mason_jar.n.01_1))
        (not (open mason_jar.n.01_2))
        (inroom electric_refrigerator.n.01_1 kitchen_0)
        (not (open electric_refrigerator.n.01_1))

        (inroom table.n.02_3 dining_room_0)
        (ontop plate.n.04_2 table.n.02_3)
        (not (covered plate.n.04_2 dust.n.01_1))
    )

    (:goal
        (and
            (ontop quiche.n.02_1 plate.n.04_2)
            (ontop plate.n.04_2 table.n.02_3)
        )
    )
)
