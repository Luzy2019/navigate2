(define (problem w0g_bacon_dishes_dining_v8-0)
    (:domain omnigibson)

    (:objects
        bacon.n.01_1 - bacon.n.01
        stove.n.01_1 - stove.n.01
        griddle.n.01_1 - griddle.n.01
        plate.n.04_1 plate.n.04_2 plate.n.04_3 - plate.n.04
        stain.n.01_1 - stain.n.01
        countertop.n.01_1 - countertop.n.01
        cabinet.n.01_1 - cabinet.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 floor.n.01_2 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop bacon.n.01_1 griddle.n.01_1)
        (not (cooked bacon.n.01_1))
        (ontop griddle.n.01_1 stove.n.01_1)
        (not (toggled_on stove.n.01_1))
        (ontop plate.n.04_1 countertop.n.01_1)
        (ontop plate.n.04_2 countertop.n.01_1)
        (covered plate.n.04_2 stain.n.01_1)
        (ontop plate.n.04_3 floor.n.01_2)
        (inroom stove.n.01_1 kitchen_0)
        (inroom countertop.n.01_1 kitchen_0)
        (inroom cabinet.n.01_1 kitchen_0)
        (inroom floor.n.01_1 kitchen_0)
        (inroom breakfast_table.n.01_1 dining_room_0)
        (inroom floor.n.01_2 dining_room_0)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (cooked bacon.n.01_1)
            (inside plate.n.04_1 cabinet.n.01_1)
            (ontop plate.n.04_3 breakfast_table.n.01_1)
            (not (toggled_on stove.n.01_1))
            (not (inside plate.n.04_2 cabinet.n.01_1))
            (not (open cabinet.n.01_1))
        )
    )
)
