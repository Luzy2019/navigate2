(define (problem w0g_microwaveoven_foil_bathroom1_v8-0)
    (:domain omnigibson)

    (:objects
        microwave.n.02_1 - microwave.n.02
        dust.n.01_1 - dust.n.01
        stain.n.01_1 - stain.n.01
        liquid_soap.n.01_1 - liquid_soap.n.01
        scrub_brush.n.01_1 scrub_brush.n.01_2 - scrub_brush.n.01
        countertop.n.01_1 - countertop.n.01
        aluminum_foil.n.01_1 - aluminum_foil.n.01
        hamburger.n.01_1 - hamburger.n.01
        plate.n.04_1 - plate.n.04
        electric_refrigerator.n.01_1 - electric_refrigerator.n.01
        cabinet.n.01_1 - cabinet.n.01
        toilet.n.02_1 - toilet.n.02
        mirror.n.01_1 - mirror.n.01
        floor.n.01_1 floor.n.01_2 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (covered microwave.n.02_1 dust.n.01_1)
        (covered microwave.n.02_1 stain.n.01_1)
        (covered microwave.n.02_1 liquid_soap.n.01_1)
        (not (open microwave.n.02_1))
        (not (toggled_on microwave.n.02_1))
        (ontop scrub_brush.n.01_1 countertop.n.01_1)
        (ontop aluminum_foil.n.01_1 hamburger.n.01_1)
        (inside hamburger.n.01_1 electric_refrigerator.n.01_1)
        (frozen hamburger.n.01_1)
        (ontop plate.n.04_1 countertop.n.01_1)
        (not (open electric_refrigerator.n.01_1))
        (covered toilet.n.02_1 dust.n.01_1)
        (covered mirror.n.01_1 dust.n.01_1)
        (ontop scrub_brush.n.01_2 floor.n.01_2)
        (inroom microwave.n.02_1 kitchen_0)
        (inroom countertop.n.01_1 kitchen_0)
        (inroom electric_refrigerator.n.01_1 kitchen_0)
        (inroom cabinet.n.01_1 kitchen_0)
        (inroom floor.n.01_1 kitchen_0)
        (inroom toilet.n.02_1 bathroom_0)
        (inroom mirror.n.01_1 bathroom_0)
        (inroom floor.n.01_2 bathroom_0)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (not (covered microwave.n.02_1 dust.n.01_1))
            (not (covered microwave.n.02_1 stain.n.01_1))
            (hot hamburger.n.01_1)
            (ontop hamburger.n.01_1 countertop.n.01_1)
            (not (covered toilet.n.02_1 dust.n.01_1))
            (not (covered mirror.n.01_1 dust.n.01_1))
            (not (covered microwave.n.02_1 liquid_soap.n.01_1))
            (not (toggled_on microwave.n.02_1))
            (not (open microwave.n.02_1))
            (inside aluminum_foil.n.01_1 cabinet.n.01_1)
            (not (open cabinet.n.01_1))
            (not (open electric_refrigerator.n.01_1))
        )
    )
)
