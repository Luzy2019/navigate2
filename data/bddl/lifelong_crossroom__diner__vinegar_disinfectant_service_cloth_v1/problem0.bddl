(define (problem lifelong_crossroom__diner__vinegar_disinfectant_service_cloth_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        door.n.01_1 - door.n.01
        sink.n.01_1 - sink.n.01
        stain.n.01_1 - stain.n.01
        rag.n.01_1 rag.n.01_2 rag.n.01_3 - rag.n.01
        compost_bin.n.01_1 - compost_bin.n.01
        bottom_cabinet.n.01_1 - bottom_cabinet.n.01
        disinfectant.n.01_1 - disinfectant.n.01
        vinegar__bottle.n.01_1 - vinegar__bottle.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 bathroom_0)
        (inroom floor.n.01_2 corridor_0)
        (inroom floor.n.01_3 bar_0)
        (inroom door.n.01_1 bathroom_0)
        (inroom sink.n.01_1 bathroom_0)
        (covered sink.n.01_1 stain.n.01_1)
        (ontop rag.n.01_1 floor.n.01_2)
        (ontop compost_bin.n.01_1 floor.n.01_2)
        (inroom bottom_cabinet.n.01_1 bar_0)
        (covered bottom_cabinet.n.01_1 stain.n.01_1)
        (ontop rag.n.01_2 floor.n.01_1)
        (ontop vinegar__bottle.n.01_1 floor.n.01_3)
        (ontop rag.n.01_3 floor.n.01_1)
        (saturated rag.n.01_2 disinfectant.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (not (covered sink.n.01_1 stain.n.01_1))
            (inside rag.n.01_1 compost_bin.n.01_1)
            (ontop rag.n.01_2 floor.n.01_3)
            (ontop rag.n.01_3 floor.n.01_3)
            (not (covered bottom_cabinet.n.01_1 stain.n.01_1))
            (or (nextto rag.n.01_2 vinegar__bottle.n.01_1) (nextto rag.n.01_3 vinegar__bottle.n.01_1))
            (not (covered vinegar__bottle.n.01_1 disinfectant.n.01_1))
            (inside rag.n.01_2 bottom_cabinet.n.01_1)
            (not (nextto rag.n.01_2 vinegar__bottle.n.01_1))
            (nextto rag.n.01_3 vinegar__bottle.n.01_1)
            (not (open door.n.01_1))
        )
    )
)
