(define (problem lifelong_crossroom__diner__kettle_hot_vase_service_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        door.n.01_1 door.n.01_2 - door.n.01
        electric_kettle.n.01_1 electric_kettle.n.01_2 electric_kettle.n.01_3 - electric_kettle.n.01
        vase.n.01_1 vase.n.01_2 - vase.n.01
        bottom_cabinet.n.01_1 - bottom_cabinet.n.01
        plate.n.04_1 - plate.n.04
        table.n.02_1 - table.n.02
        water.n.06_1 - water.n.06
        compost_bin.n.01_1 - compost_bin.n.01
        sink.n.01_1 - sink.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 kitchen_0)
        (inroom floor.n.01_2 bar_0)
        (inroom floor.n.01_3 dining_room_0)
        (inroom door.n.01_1 kitchen_0)
        (inroom door.n.01_2 dining_room_0)
        (ontop electric_kettle.n.01_1 floor.n.01_1)
        (ontop vase.n.01_1 floor.n.01_2)
        (inroom bottom_cabinet.n.01_1 bar_0)
        (ontop plate.n.04_1 floor.n.01_3)
        (inroom table.n.02_1 dining_room_0)
        (ontop electric_kettle.n.01_2 floor.n.01_1)
        (ontop vase.n.01_2 floor.n.01_3)
        (ontop compost_bin.n.01_1 floor.n.01_3)
        (ontop electric_kettle.n.01_3 floor.n.01_1)
        (hot electric_kettle.n.01_2)
        (inroom sink.n.01_1 kitchen_0)
        (insource sink.n.01_1 water.n.06_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (hot electric_kettle.n.01_1)
            (inside vase.n.01_1 bottom_cabinet.n.01_1)
            (ontop electric_kettle.n.01_2 floor.n.01_3)
            (ontop electric_kettle.n.01_3 floor.n.01_3)
            (ontop plate.n.04_1 table.n.02_1)
            (or (nextto electric_kettle.n.01_2 vase.n.01_2) (nextto electric_kettle.n.01_3 vase.n.01_2))
            (not (hot electric_kettle.n.01_2))
            (not (nextto electric_kettle.n.01_2 vase.n.01_2))
            (nextto electric_kettle.n.01_3 vase.n.01_2)
            (not (open door.n.01_1))
            (not (open door.n.01_2))
        )
    )
)
