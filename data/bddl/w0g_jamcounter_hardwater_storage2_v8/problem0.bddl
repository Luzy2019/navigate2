(define (problem w0g_jamcounter_hardwater_storage2_v8-0)
    (:domain omnigibson)

    (:objects
        jar__of__jam.n.01_1 - jar__of__jam.n.01
        countertop.n.01_1 - countertop.n.01
        dirt.n.02_1 - dirt.n.02
        scrub_brush.n.01_1 scrub_brush.n.01_2 - scrub_brush.n.01
        sink.n.01_1 - sink.n.01
        liquid_soap.n.01_1 - liquid_soap.n.01
        liquid_soap__bottle.n.01_1 - liquid_soap__bottle.n.01
        cabinet.n.01_1 - cabinet.n.01
        stain.n.01_1 - stain.n.01
        vinegar.n.01_1 - vinegar.n.01
        vinegar__bottle.n.01_1 - vinegar__bottle.n.01
        bowl.n.01_1 - bowl.n.01
        door.n.01_1 - door.n.01
        dust.n.01_1 - dust.n.01
        floor.n.01_1 floor.n.01_2 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop jar__of__jam.n.01_1 countertop.n.01_1)
        (covered countertop.n.01_1 dirt.n.02_1)
        (ontop scrub_brush.n.01_1 countertop.n.01_1)
        (filled liquid_soap__bottle.n.01_1 liquid_soap.n.01_1)
        (ontop liquid_soap__bottle.n.01_1 countertop.n.01_1)
        (covered sink.n.01_1 stain.n.01_1)
        (filled vinegar__bottle.n.01_1 vinegar.n.01_1)
        (filled bowl.n.01_1 vinegar.n.01_1)
        (ontop vinegar__bottle.n.01_1 countertop.n.01_1)
        (ontop bowl.n.01_1 countertop.n.01_1)
        (ontop scrub_brush.n.01_2 countertop.n.01_1)
        (covered door.n.01_1 dust.n.01_1)
        (open door.n.01_1)
        (inroom countertop.n.01_1 kitchen_0)
        (inroom sink.n.01_1 kitchen_0)
        (inroom cabinet.n.01_1 kitchen_0)
        (inroom floor.n.01_1 kitchen_0)
        (inroom door.n.01_1 storage_room_0)
        (inroom floor.n.01_2 storage_room_0)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (not (covered countertop.n.01_1 dirt.n.02_1))
            (not (covered sink.n.01_1 stain.n.01_1))
            (not (covered door.n.01_1 dust.n.01_1))
            (not (open door.n.01_1))
            (inside liquid_soap__bottle.n.01_1 cabinet.n.01_1)
            (not (filled bowl.n.01_1 vinegar.n.01_1))
            (not (toggled_on sink.n.01_1))
        )
    )
)
