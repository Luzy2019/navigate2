(define (problem lifelong_crossroom__beechwood__bath_disinfectant_vinegar_rag_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        sink.n.01_1 sink.n.01_2 - sink.n.01
        stain.n.01_1 - stain.n.01
        rag.n.01_1 rag.n.01_2 rag.n.01_3 - rag.n.01
        disinfectant.n.01_1 - disinfectant.n.01
        vinegar__bottle.n.01_1 - vinegar__bottle.n.01
        clothes_dryer.n.01_1 - clothes_dryer.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 bathroom_0)
        (inroom floor.n.01_2 corridor_0)
        (inroom floor.n.01_3 utility_room_0)
        (inroom sink.n.01_1 bathroom_0)
        (covered sink.n.01_1 stain.n.01_1)
        (ontop rag.n.01_2 floor.n.01_1)
        (ontop rag.n.01_1 floor.n.01_2)
        (inroom sink.n.01_2 utility_room_0)
        (covered sink.n.01_2 stain.n.01_1)
        (inroom clothes_dryer.n.01_1 utility_room_0)
        (ontop vinegar__bottle.n.01_1 clothes_dryer.n.01_1)
        (covered vinegar__bottle.n.01_1 stain.n.01_1)
        (ontop rag.n.01_3 clothes_dryer.n.01_1)
        (saturated rag.n.01_2 disinfectant.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (not (covered sink.n.01_1 stain.n.01_1))
            (ontop rag.n.01_1 clothes_dryer.n.01_1)
            (not (covered sink.n.01_2 stain.n.01_1))
            (ontop rag.n.01_2 clothes_dryer.n.01_1)
            (not (covered vinegar__bottle.n.01_1 stain.n.01_1))
            (not (covered vinegar__bottle.n.01_1 disinfectant.n.01_1))
            (ontop rag.n.01_3 clothes_dryer.n.01_1)
        )
    )
)
