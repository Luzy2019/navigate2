(define (problem lifelong_crossroom__diner__shellfish_board_salad_service_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        door.n.01_1 door.n.01_2 - door.n.01
        huitre.n.01_1 - huitre.n.01
        bottom_cabinet.n.01_1 - bottom_cabinet.n.01
        stain.n.01_1 - stain.n.01
        plate.n.04_1 plate.n.04_2 - plate.n.04
        table.n.02_1 - table.n.02
        chopping_board.n.01_1 chopping_board.n.01_2 - chopping_board.n.01
        compost_bin.n.01_1 - compost_bin.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 kitchen_0)
        (inroom floor.n.01_2 bar_0)
        (inroom floor.n.01_3 dining_room_0)
        (inroom door.n.01_1 kitchen_0)
        (inroom door.n.01_2 dining_room_0)
        (ontop huitre.n.01_1 floor.n.01_1)
        (inroom bottom_cabinet.n.01_1 bar_0)
        (covered bottom_cabinet.n.01_1 stain.n.01_1)
        (ontop plate.n.04_1 floor.n.01_3)
        (inroom table.n.02_1 dining_room_0)
        (ontop chopping_board.n.01_1 floor.n.01_1)
        (ontop plate.n.04_2 floor.n.01_3)
        (ontop compost_bin.n.01_1 floor.n.01_3)
        (ontop chopping_board.n.01_2 floor.n.01_1)
        (covered chopping_board.n.01_1 stain.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (cooked huitre.n.01_1)
            (not (covered bottom_cabinet.n.01_1 stain.n.01_1))
            (ontop chopping_board.n.01_1 floor.n.01_3)
            (ontop chopping_board.n.01_2 floor.n.01_3)
            (ontop plate.n.04_1 table.n.02_1)
            (or (nextto chopping_board.n.01_1 plate.n.04_2) (nextto chopping_board.n.01_2 plate.n.04_2))
            (not (covered plate.n.04_2 stain.n.01_1))
            (not (nextto chopping_board.n.01_1 plate.n.04_2))
            (nextto chopping_board.n.01_2 plate.n.04_2)
            (not (open door.n.01_1))
            (not (open door.n.01_2))
        )
    )
)
