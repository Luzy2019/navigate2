(define (problem lifelong_crossroom__diner__wet_utensil_hot_oil_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        door.n.01_1 door.n.01_2 - door.n.01
        sink.n.01_1 - sink.n.01
        stain.n.01_1 - stain.n.01
        rag.n.01_1 - rag.n.01
        compost_bin.n.01_1 - compost_bin.n.01
        stove.n.01_1 - stove.n.01
        cooking_oil.n.01_1 - cooking_oil.n.01
        carving_knife.n.01_1 carving_knife.n.01_2 - carving_knife.n.01
        water.n.06_1 - water.n.06
        bottom_cabinet.n.01_1 - bottom_cabinet.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 bathroom_0)
        (inroom floor.n.01_2 corridor_0)
        (inroom floor.n.01_3 kitchen_0)
        (inroom door.n.01_1 bathroom_0)
        (inroom door.n.01_2 kitchen_0)
        (inroom sink.n.01_1 bathroom_0)
        (covered sink.n.01_1 stain.n.01_1)
        (ontop rag.n.01_1 floor.n.01_2)
        (ontop compost_bin.n.01_1 floor.n.01_2)
        (inroom stove.n.01_1 kitchen_0)
        (covered stove.n.01_1 cooking_oil.n.01_1)
        (ontop carving_knife.n.01_1 floor.n.01_1)
        (inroom bottom_cabinet.n.01_1 kitchen_0)
        (ontop carving_knife.n.01_2 floor.n.01_1)
        (covered carving_knife.n.01_1 water.n.06_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (not (covered sink.n.01_1 stain.n.01_1))
            (inside rag.n.01_1 compost_bin.n.01_1)
            (ontop carving_knife.n.01_1 floor.n.01_3)
            (ontop carving_knife.n.01_2 floor.n.01_3)
            (not (covered stove.n.01_1 cooking_oil.n.01_1))
            (or (nextto carving_knife.n.01_1 stove.n.01_1) (nextto carving_knife.n.01_2 stove.n.01_1))
            (not (nextto carving_knife.n.01_1 stove.n.01_1))
            (inside carving_knife.n.01_1 bottom_cabinet.n.01_1)
            (nextto carving_knife.n.01_2 stove.n.01_1)
            (not (open door.n.01_1))
            (not (open door.n.01_2))
        )
    )
)
