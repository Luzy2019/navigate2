            (ontop mason_jar.n.01_1 countertop.n.01_1)
            (not (covered sink.n.01_1 stain.n.01_1))
            (inside plate.n.04_1 bottom_cabinet.n.01_1)
            (ontop mason_jar.n.01_2 table.n.02_1)
