(define (problem lifelong_crossroom__pomaria__heavy_jar_low_shelf_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        door.n.01_1 door.n.01_2 - door.n.01
        mason_jar.n.01_1 mason_jar.n.01_2 mason_jar.n.01_3 - mason_jar.n.01
        water.n.06_1 - water.n.06
        sink.n.01_1 - sink.n.01
        stain.n.01_1 - stain.n.01
        plate.n.04_1 - plate.n.04
        bottom_cabinet.n.01_1 - bottom_cabinet.n.01
        top_cabinet.n.01_1 - top_cabinet.n.01
        countertop.n.01_1 - countertop.n.01
        table.n.02_1 - table.n.02
        shelf.n.01_1 - shelf.n.01
        washer.n.03_1 - washer.n.03
        clothes_dryer.n.01_1 - clothes_dryer.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 pantry_room_0)
        (inroom floor.n.01_2 utility_room_0)
        (inroom floor.n.01_3 kitchen_0)
        (inroom door.n.01_1 utility_room_0)
        (inroom door.n.01_2 kitchen_0)
        (ontop mason_jar.n.01_1 countertop.n.01_1)
        (inroom sink.n.01_1 utility_room_0)
        (inroom bottom_cabinet.n.01_1 kitchen_0)
        (inroom top_cabinet.n.01_1 kitchen_0)
        (ontop mason_jar.n.01_3 countertop.n.01_1)
        (inside plate.n.04_1 bottom_cabinet.n.01_1)
        (ontop mason_jar.n.01_2 table.n.02_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
