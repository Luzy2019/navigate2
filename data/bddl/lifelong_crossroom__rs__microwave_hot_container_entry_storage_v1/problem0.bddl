(define (problem lifelong_crossroom__rs__microwave_hot_container_entry_storage_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        door.n.01_1 - door.n.01
        tupperware.n.01_1 tupperware.n.01_2 tupperware.n.01_3 - tupperware.n.01
        water.n.06_1 - water.n.06
        table.n.02_1 - table.n.02
        dust.n.01_1 - dust.n.01
        rag.n.01_1 - rag.n.01
        bucket.n.01_1 - bucket.n.01
        bottom_cabinet.n.01_1 - bottom_cabinet.n.01
        compost_bin.n.01_1 - compost_bin.n.01
        sink.n.01_1 - sink.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 kitchen_0)
        (inroom floor.n.01_2 living_room_0)
        (inroom floor.n.01_3 entryway_0)
        (inroom door.n.01_1 entryway_0)
        (ontop tupperware.n.01_1 floor.n.01_1)
        (inroom table.n.02_1 living_room_0)
        (covered table.n.02_1 dust.n.01_1)
        (ontop rag.n.01_1 floor.n.01_3)
        (ontop bucket.n.01_1 floor.n.01_3)
        (ontop tupperware.n.01_2 floor.n.01_1)
        (inroom bottom_cabinet.n.01_1 entryway_0)
        (ontop compost_bin.n.01_1 floor.n.01_3)
        (ontop tupperware.n.01_3 floor.n.01_1)
        (hot tupperware.n.01_2)
        (inroom sink.n.01_1 kitchen_0)
        (insource sink.n.01_1 water.n.06_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (filled tupperware.n.01_1 water.n.06_1)
            (not (covered table.n.02_1 dust.n.01_1))
            (ontop tupperware.n.01_2 floor.n.01_3)
            (ontop tupperware.n.01_3 floor.n.01_3)
            (inside rag.n.01_1 bucket.n.01_1)
            (or (nextto tupperware.n.01_2 bottom_cabinet.n.01_1) (nextto tupperware.n.01_3 bottom_cabinet.n.01_1))
            (not (hot tupperware.n.01_2))
            (not (nextto tupperware.n.01_2 bottom_cabinet.n.01_1))
            (nextto tupperware.n.01_3 bottom_cabinet.n.01_1)
            (not (open door.n.01_1))
        )
    )
)
