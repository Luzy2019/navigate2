(define (problem lifelong_crossroom__rs__hot_dish_sofa_towel_v1-0)
    (:domain omnigibson)

    (:objects
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        chicken_leg.n.01_1 - chicken_leg.n.01
        sofa.n.01_1 - sofa.n.01
        dust.n.01_1 - dust.n.01
        rag.n.01_1 rag.n.01_2 - rag.n.01
        bucket.n.01_1 - bucket.n.01
        tupperware.n.01_1 tupperware.n.01_2 - tupperware.n.01
        water.n.06_1 - water.n.06
        compost_bin.n.01_1 - compost_bin.n.01
        sink.n.01_1 - sink.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 kitchen_0)
        (inroom floor.n.01_2 living_room_0)
        (inroom floor.n.01_3 entryway_0)
        (ontop chicken_leg.n.01_1 floor.n.01_1)
        (frozen chicken_leg.n.01_1)
        (inroom sofa.n.01_1 living_room_0)
        (covered sofa.n.01_1 dust.n.01_1)
        (ontop rag.n.01_1 floor.n.01_3)
        (ontop bucket.n.01_1 floor.n.01_3)
        (ontop tupperware.n.01_1 floor.n.01_1)
        (ontop rag.n.01_2 floor.n.01_3)
        (ontop compost_bin.n.01_1 floor.n.01_3)
        (ontop tupperware.n.01_2 floor.n.01_1)
        (hot tupperware.n.01_1)
        (inroom sink.n.01_1 kitchen_0)
        (insource sink.n.01_1 water.n.06_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (hot chicken_leg.n.01_1)
            (not (frozen chicken_leg.n.01_1))
            (not (covered sofa.n.01_1 dust.n.01_1))
            (inside rag.n.01_1 bucket.n.01_1)
            (or (nextto tupperware.n.01_1 rag.n.01_2) (nextto tupperware.n.01_2 rag.n.01_2))
            (not (hot tupperware.n.01_1))
            (not (nextto tupperware.n.01_1 rag.n.01_2))
            (nextto tupperware.n.01_2 rag.n.01_2)
        )
    )
)
