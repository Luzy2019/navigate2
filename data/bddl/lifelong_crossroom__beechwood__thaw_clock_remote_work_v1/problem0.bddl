(define (problem lifelong_crossroom__beechwood__thaw_clock_remote_work_v1-0)
    (:domain omnigibson)

    (:objects
        swab.n.02_1 - swab.n.02
        rag.n.01_1 - rag.n.01
        table_lamp.n.01_1 - table_lamp.n.01
        table.n.02_1 - table.n.02
        coffee_table.n.01_1 - coffee_table.n.01
        dirt.n.02_1 - dirt.n.02
        water.n.06_1 - water.n.06
        floor.n.01_1 floor.n.01_2 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_2 kitchen_0)
        (ontop agent.n.01_1 floor.n.01_2)
        (ontop swab.n.02_1 floor.n.01_2)
        (saturated swab.n.02_1 water.n.06_1)
        (inroom table.n.02_1 kitchen_0)
        (ontop table_lamp.n.01_1 table.n.02_1)
        (ontop rag.n.01_1 table.n.02_1)
        (not (toggled_on table_lamp.n.01_1))

        (inroom coffee_table.n.01_1 living_room_0)
        (inroom floor.n.01_1 living_room_0)
        (covered floor.n.01_1 dirt.n.02_1)
        (not (covered floor.n.01_1 water.n.06_1))
    )

    (:goal
        (and
            (ontop table_lamp.n.01_1 coffee_table.n.01_1)
        )
    )
)
