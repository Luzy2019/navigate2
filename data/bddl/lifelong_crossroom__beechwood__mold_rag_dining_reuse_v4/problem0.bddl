(define (problem lifelong_crossroom__beechwood__mold_rag_dining_reuse_v4-0)
    (:domain omnigibson)

    (:objects
        rag.n.01_1 rag.n.01_2 - rag.n.01
        water.n.06_1 - water.n.06
        sink.n.01_1 - sink.n.01
        stain.n.01_1 - stain.n.01
        dust.n.01_1 - dust.n.01
        power_strip.n.01_1 - power_strip.n.01
        table.n.02_1 table.n.02_2 table.n.02_3 table.n.02_4 - table.n.02
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inroom floor.n.01_1 kitchen_0)
        (ontop agent.n.01_1 floor.n.01_1)
        (inroom sink.n.01_1 kitchen_0)
        (insource sink.n.01_1 water.n.06_1)
        (covered sink.n.01_1 stain.n.01_1)
        (inroom table.n.02_1 kitchen_0)
        (ontop rag.n.01_1 table.n.02_1)
        (ontop rag.n.01_2 table.n.02_1)
        (not (saturated rag.n.01_1 water.n.06_1))
        (not (saturated rag.n.01_2 water.n.06_1))
        (not (covered rag.n.01_1 stain.n.01_1))
        (not (covered rag.n.01_2 stain.n.01_1))

        (inroom floor.n.01_2 dining_room_0)

        (inroom floor.n.01_3 living_room_1)
        (inroom table.n.02_2 living_room_1)
        (inroom table.n.02_3 living_room_1)
        (inroom table.n.02_4 living_room_1)
        (ontop power_strip.n.01_1 table.n.02_4)
        (not (covered table.n.02_4 dust.n.01_1))
        (not (covered power_strip.n.01_1 water.n.06_1))
    )

    (:goal
        (and
            (not (covered sink.n.01_1 stain.n.01_1))
            (not (covered table.n.02_4 dust.n.01_1))
            (not (covered power_strip.n.01_1 water.n.06_1))
            (ontop power_strip.n.01_1 table.n.02_4)
        )
    )
)
