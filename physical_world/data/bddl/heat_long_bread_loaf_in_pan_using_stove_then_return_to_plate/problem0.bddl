(define (problem heat_long_bread_loaf_in_pan_using_stove_then_return_to_plate-0)
    (:domain omnigibson)

    (:objects
        long_bread_loaf.n.01_1 - long_bread_loaf.n.01
        pan.n.01_1 - pan.n.01
        stove.n.01_1 - stove.n.01
        plate.n.01_1 - plate.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop pan.n.01_1 stove.n.01_1)
        (ontop plate.n.01_1 countertop.n.01_1)
        (ontop long_bread_loaf.n.01_1 plate.n.01_1)
        (not
            (cooked long_bread_loaf.n.01_1)
        )
        (not
            (toggled_on stove.n.01_1)
        )
        (inroom stove.n.01_1 kitchen)
        (inroom countertop.n.01_1 kitchen)
        (inroom floor.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (cooked ?long_bread_loaf.n.01_1)
            (ontop ?long_bread_loaf.n.01_1 ?plate.n.01_1)
            (not
                (toggled_on ?stove.n.01_1)
            )
        )
    )
)
