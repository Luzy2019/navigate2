(define (problem place_ring_shaped_bread_and_tissue_box_inside_top_compartment_of_the_cabinet-0)
    (:domain omnigibson)

    (:objects
        ring_shaped_bread.n.01_1 - ring_shaped_bread.n.01
        tissue_box.n.01_1 - tissue_box.n.01
        top_compartment_of_the_cabinet.n.01_1 - top_compartment_of_the_cabinet.n.01
        cabinet.n.01_1 - cabinet.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop ring_shaped_bread.n.01_1 countertop.n.01_1)
        (ontop tissue_box.n.01_1 countertop.n.01_1)
        (inroom top_compartment_of_the_cabinet.n.01_1 kitchen)
        (inroom cabinet.n.01_1 kitchen)
        (inroom countertop.n.01_1 kitchen)
        (inroom floor.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (inside ?ring_shaped_bread.n.01_1 ?top_compartment_of_the_cabinet.n.01_1)
            (inside ?tissue_box.n.01_1 ?top_compartment_of_the_cabinet.n.01_1)
        )
    )
)
